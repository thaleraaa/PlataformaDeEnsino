// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Aluno {
  id String @id @default(uuid())

  periodo String
  faculdade String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conta_id String @unique
  conta Conta @relation(fields: [conta_id], references: [id], onDelete: Cascade)

  resultado Resultado[]
  progresso Progresso[]
  conclusaoAula ConclusaoAula[]
}

model Administrador {
  id String @id @default(uuid())
  ativo Boolean

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  conta_id String @unique
  conta Conta @relation(fields: [conta_id], references: [id])

  professor Professor[]
}

model Professor {
  id String @id @default(uuid())
  CRM String @unique
  salario Float
  ativo Boolean @default(true)


  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  conta_id String @unique
  conta Conta @relation(fields: [conta_id], references: [id])

  adm_id String
  administrador Administrador @relation(fields: [adm_id], references: [id])

  disciplina Disciplina[]
  exercicio Exercicio[]
  simulado Simulado[]
}

enum Role {
  ADMINISTRADOR
  PROFESSOR
  ALUNO
}

model Conta {
  id String @id @default(uuid())
  nome String
  email String @unique
  senha String
  role Role

  aluno Aluno?
  professor Professor?
  administrador Administrador?
}

model Disciplina {
  id String @id @default(uuid())
  nome String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  professor_id String
  professor Professor @relation(fields: [professor_id], references: [id])

  modulos Modulo[]
  progresso Progresso[]
}

model Modulo {
  id String @id @default(uuid())
  nome String
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  disciplina_id String
  disciplina Disciplina @relation(fields: [disciplina_id], references: [id])

  aula Aula[]
}

model Aula {
  id String @id @default(uuid())
  nome String
  videoAula String
  texto String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  modulo_id String
  modulo Modulo @relation(fields: [modulo_id], references: [id])

  exercicio Exercicio[]
  conclusaoAula ConclusaoAula[]
}

model Exercicio {
  id String @id @default(uuid())
  enunciado String
  dificuldade String

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  aula_id String?
  aula Aula? @relation(fields: [aula_id], references: [id])

  professor_id String
  professor Professor @relation(fields: [professor_id], references: [id])

  simulado_id String?
  simulado Simulado? @relation(fields: [simulado_id], references: [id])

  alternativa Alternativa[]
}

model Alternativa {
  id String @id @default(uuid())
  texto String
  correta Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  exercicio_id String
  exercicio Exercicio @relation(fields: [exercicio_id], references: [id])
}

model Simulado {
  id String @id @default(uuid())
  quantidadeQuestao Int
  tempoMaximo Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  professor_id String
  professor Professor @relation(fields: [professor_id], references: [id])

  exercicio Exercicio[]
  resultado Resultado[]
}


model Resultado {
  id String @id @default(uuid())
  nota Float
  tempoSegundos Int
  dataRealizacao DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  simulado_id String
  simulado Simulado @relation(fields: [simulado_id], references: [id])

  aluno_id String
  aluno Aluno @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  @@unique([aluno_id, simulado_id])
}

model Progresso {
  id String @id @default(uuid())
  porcentagemConcluida Float

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  aluno_id String
  aluno Aluno @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  disciplina_id String
  disciplina Disciplina @relation(fields: [disciplina_id], references: [id])

  @@unique([aluno_id, disciplina_id])
}

model ConclusaoAula {
  id String @id @default(uuid())
  dataConclusao DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  aluno_id String
  aluno Aluno @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  aula_id String
  aula Aula @relation(fields: [aula_id], references: [id])

  @@unique([aluno_id,aula_id])
}